{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "lib/judge0.js", "app/(root)/problem/page.jsx", "modules/problems/actions/index.js", "modules/problems/components/test-case-table.jsx", "modules/problems/components/problem-table.jsx", "modules/problems/components/add-to-playlist.jsx", "modules/problems/components/create-playlist.jsx", "app/(root)/profile/page.jsx"  ],
  "exclude": ["node_modules"]
}
